{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": [
    {
      "target": "dashboard",
      "public": "web",
      "ignore": [
        "firebase.json",
        "README.md",
        "**/.*",
        "**/node_modules/**",
        "assets/**"
      ],
      "rewrites": [
        {
          "source": "/",
          "destination": "/dashboard.html"
        }
      ],
      "headers": [
        {
          "source": "app-update.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    },
    {
      "target": "storefront",
      "public": "site-web",
      "ignore": [
        "firebase.json",
        "README.md",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        }
      ]
    }
  ]
}
