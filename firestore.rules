rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /produits/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /publications/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_produits/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_publications/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /site_contenu/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /app_config/{document} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
